{
  "name": "tempoo-analytics",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "run-script-os",
    "start:win32": "ng serve --port %PORT% --proxy-config proxy.conf.js",
    "start:default": "ng serve --port $PORT --proxy-config proxy.conf.js",
    "start:community": "run-script-os",
    "start:community:win32": "ng serve --configuration community --port %PORT% --proxy-config proxy.conf.js",
    "start:community:default": "ng serve --configuration community --port $PORT --proxy-config proxy.conf.js",
    "build": "ng build",
    "build:community": "ng build --configuration production,community --output-path dist/community",
    "watch": "ng build --watch --configuration development",
    "test": "vitest",
    "test:e2e:editions": "playwright test -c playwright.editions.config.ts",
    "e2e:install": "npx playwright install",
    "tempoo": "tempoo"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "21.2.26",
    "@angular/cdk": "^21.2.0",
    "@angular/common": "21.2.26",
    "@angular/compiler": "21.2.26",
    "@angular/core": "21.2.26",
    "@angular/forms": "21.2.26",
    "@angular/platform-browser": "21.2.26",
    "@angular/router": "21.2.26",
    "@primeuix/themes": "^2.0.0",
    "@swimlane/ngx-charts": "^25.0.3",
    "@tailwindcss/postcss": "^4.1.17",
    "canvas-confetti": "^1.9.4",
    "chart.js": "^4.5.1",
    "maplibre-gl": "^6.19.0",
    "primeicons": "^7.0.0",
    "primeng": "^21.1.10",
    "rxjs": "~7.8.0",
    "tailwindcss": "^4.1.17",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.30",
    "@angular/cli": "^21.2.30",
    "@angular/compiler-cli": "21.2.26",
    "@angular/platform-browser-dynamic": "21.2.26",
    "@playwright/test": "1.65.1",
    "@testing-library/angular": "^19.6.0",
    "@testing-library/jest-dom": "^6.0.0",
    "@testing-library/user-event": "^14.6.0",
    "@types/canvas-confetti": "^1.9.0",
    "@types/d3-shape": "^3.1.7",
    "@types/jasmine": "~5.1.0",
    "autoprefixer": "^10.4.22",
    "jasmine-core": "~5.9.0",
    "jsdom": "^22.1.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.3.0",
    "postcss": "^8.5.6",
    "puppeteer": "^25.18.1",
    "run-script-os": "^1.1.6",
    "typescript": "~5.9.2",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^4.1.12",
    "zone.js": "^0.16.3"
  }
}
