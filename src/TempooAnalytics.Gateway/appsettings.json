{
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft.AspNetCore": "Warning",
            "Yarp": "Warning"
        }
    },
    "AllowedHosts": "*",
    "ReverseProxy": {
        "Routes": {
            "ingestion-route": {
                "ClusterId": "ingestion-cluster",
                "CorsPolicy": "OpenNoCredentials",
                "Match": {
                    "Path": "/analytics/{**catch-all}"
                }
            },
            "heatmap-overlay-route": {
                "ClusterId": "api-cluster",
                "CorsPolicy": "OpenNoCredentials",
                "Order": 0,
                "Match": {
                    "Path": "/api/public/heatmaps/overlay"
                }
            },
            "api-route": {
                "ClusterId": "api-cluster",
                "Match": {
                    "Path": "/api/{**catch-all}"
                }
            },
            "web-route": {
                "ClusterId": "web-cluster",
                "Match": {
                    "Path": "{**catch-all}"
                },
                "Order": 1000
            }
        },
        "Clusters": {
            "ingestion-cluster": {
                "HttpRequest": {
                    "ActivityTimeout": "00:00:10"
                },
                "Destinations": {
                    "destination1": {
                        "Address": "http://ingestion-service"
                    }
                }
            },
            "api-cluster": {
                "Destinations": {
                    "destination1": {
                        "Address": "http://tempooanalytics-api"
                    }
                }
            },
            "web-cluster": {
                "Destinations": {
                    "destination1": {
                        "Address": "http://web"
                    }
                }
            }
        }
    }
}
