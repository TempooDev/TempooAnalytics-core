<Project Sdk="Aspire.AppHost.Sdk/13.4.3">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UserSecretsId>d9eebfd0-b886-4cd6-824a-44803cd00588</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Hosting.JavaScript" />
    <!-- Security: overrides vulnerable transitive MessagePack from Aspire.Hosting (GHSA-hv8m-jj95-wg3x). -->
    <PackageReference Include="MessagePack" />
    <PackageReference Include="Aspire.Hosting.PostgreSQL" />
    <PackageReference Include="Aspire.Hosting.Redis" />
    <PackageReference Include="Aspire.Hosting.Yarp" />
    <PackageReference Include="CommunityToolkit.Aspire.Hosting.Golang" />
    <PackageReference Include="Npgsql" VersionOverride="8.0.9" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\TempooAnalytics.Api\TempooAnalytics.Api.csproj" />
    <ProjectReference Include="..\TempooAnalytics.Gateway\TempooAnalytics.Gateway.csproj" />
  </ItemGroup>

  <!-- Overlay of the cloud edition (private tree only: the file does not exist in the public one). See AppHostEdition.cs. -->
  <Import Project="TempooAnalytics.AppHost.Cloud.props" Condition="Exists('TempooAnalytics.AppHost.Cloud.props')" />
</Project>
