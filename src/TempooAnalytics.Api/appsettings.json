{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "Microsoft.AspNetCore.DataProtection.KeyManagement.XmlKeyManager": "Error"
    }
  },
  "EnablePayments": true,
  "FeatureFlags": {
    "PlausibleImport": true,
    "Ga4Import": false,
    "AiWeeklyDigest": false,
    "Notifications": false,
    "AiCredits": false,
    "Heatmaps": false,
    "PublicApi": false
  },
  "Ai": {
    "Provider": "none",
    "Vertex": {
      "ProjectId": "",
      "Location": "europe-west1"
    },
    "OpenRouter": {
      "ApiKey": ""
    },
    "Models": {
      "WeeklyDigest": ""
    },
    "Prices": {},
    "WeeklyDigest": {
      "MaxCallsPerRun": 200,
      "PreviewUserIds": []
    },
    "Credits": {
      "Enforce": false,
      "Costs": {
        "ask": 1,
        "funnel_analysis": 10,
        "client_report": 15,
        "deep_audit": 50
      },
      "ReservationTimeoutMinutes": {
        "Default": 15
      }
    }
  },
  "ConnectionStrings": {
    "analytics-db": "Host=localhost;Port=5432;Database=analytics-db;Username=analytics_user;Password=analytics_password"
  },
  "Outbox": {
    "PollingIntervalSeconds": 10
  },
  "AllowedHosts": "*"
}