@page "/admin/feedback"
@model TempooAnalytics.Api.Pages.Admin.FeedbackModel
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="es" class="h-full bg-slate-950">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Feedback - Admin - Tempoo Analytics</title>
    @* Tailwind, the icons and the font are inlined (AdminAssets): no request to a third-party CDN. *@
    @AdminAssets.Styles
    @AdminAssets.Font
    <style>
        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
        }
    </style>
</head>

<body class="min-h-screen text-slate-200 bg-slate-950">
    <div class="max-w-6xl mx-auto p-6">
        <header class="flex items-center justify-between mb-8 border-b border-slate-800 pb-6">
            <div class="flex items-center gap-6">
                <div class="flex items-center gap-3">
                    <img src="/assets/images/tempoo-analytics-optimized.svg" alt="Logo" class="h-8">
                    <h1 class="text-xl font-bold text-slate-100">Admin <span class="text-sky-500">Console</span></h1>
                </div>
                
                @if (Model.IsUnlocked)
                {
                    <nav class="flex items-center gap-1 bg-slate-900 p-1 rounded-lg border border-slate-800">
                        <a href="/admin/users"
                           class="px-4 py-1.5 rounded-md text-xs font-bold transition-all text-slate-400 hover:text-slate-200">Usuarios</a>
                        @foreach (var link in AdminNav.Links(HttpContext, true))
                        {
                        <a href="@link.Href"
                           class="px-4 py-1.5 rounded-md text-xs font-bold transition-all text-slate-400 hover:text-slate-200">@link.Label</a>
                        }
                        <a href="/admin/feedback"
                           class="px-4 py-1.5 rounded-md text-xs font-bold transition-all bg-sky-500 text-slate-950 shadow-lg shadow-sky-500/20">Feedback</a>
                        @foreach (var link in AdminNav.Links(HttpContext, false))
                        {
                        <a href="@link.Href"
                           class="px-4 py-1.5 rounded-md text-xs font-bold transition-all text-slate-400 hover:text-slate-200">@link.Label</a>
                        }
                    </nav>
                }
            </div>
            @if (Model.IsUnlocked)
            {
                <form method="post" asp-page-handler="Logout">
                    <button type="submit"
                            class="text-slate-500 hover:text-rose-400 text-xs font-medium transition-colors">Cerrar
                        Sesión</button>
                </form>
            }
        </header>

        <main>
            @if (!Model.IsUnlocked)
            {
                <div class="flex items-center justify-center min-h-[60vh]">
                    <div class="bg-slate-900 p-8 rounded-2xl border border-slate-800 shadow-2xl w-full max-w-md">
                        <h2 class="text-2xl font-bold mb-2">Administración</h2>
                        <p class="text-slate-400 text-sm mb-8">Esta área es solo para administradores. Se requiere la Master Password.</p>

                        @if (Model.ErrorMessage != null)
                        {
                            <div class="bg-rose-500/10 border border-rose-500/20 text-rose-400 px-4 py-3 rounded-xl text-sm mb-6">
                                @Model.ErrorMessage
                            </div>
                        }

                        <form method="post" asp-page-handler="Unlock">
                            <div class="space-y-4">
                                <div>
                                    <label class="block text-sm font-medium text-slate-300 mb-1.5">Master Password</label>
                                    <input type="password" asp-for="MasterPassword" required
                                        class="block w-full rounded-xl border-0 bg-slate-800 py-2.5 text-white shadow-sm ring-1 ring-inset ring-slate-700 placeholder:text-slate-500 focus:ring-2 focus:ring-inset focus:ring-sky-500 sm:text-sm sm:leading-6 transition-all"
                                        placeholder="••••••••">
                                </div>
                                <button type="submit"
                                    class="flex w-full justify-center rounded-xl bg-sky-600 px-3 py-2.5 text-sm font-bold leading-6 text-white shadow-sm hover:bg-sky-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-sky-600 transition-all">
                                    Acceder
                                </button>
                            </div>
                        </form>
                    </div>
                </div>
            }
            else
            {
                <div class="sm:flex sm:items-center mb-8">
                    <div class="sm:flex-auto">
                        <h1 class="text-3xl font-bold text-white">Feedback de Usuarios</h1>
                        <p class="mt-2 text-sm text-slate-400">Listado de feedback enviado por los usuarios a través de la aplicación.</p>
                    </div>
                </div>

                <div class="bg-slate-900 rounded-2xl border border-slate-800 overflow-hidden shadow-xl">
                    <table class="min-w-full divide-y divide-slate-800">
                        <thead class="bg-slate-900/50">
                            <tr>
                                <th class="px-6 py-4 text-left text-xs font-bold text-slate-400 uppercase tracking-wider">Usuario</th>
                                <th class="px-6 py-4 text-left text-xs font-bold text-slate-400 uppercase tracking-wider">Título</th>
                                <th class="px-6 py-4 text-left text-xs font-bold text-slate-400 uppercase tracking-wider">Descripción</th>
                                <th class="px-6 py-4 text-left text-xs font-bold text-slate-400 uppercase tracking-wider">Fecha</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-slate-800 bg-slate-900/20">
                            @if (Model.AllFeedback.Count == 0)
                            {
                                <tr>
                                    <td colspan="4" class="px-6 py-12 text-center text-slate-500 italic">No hay feedback registrado todavía.</td>
                                </tr>
                            }
                            @foreach (var feedback in Model.AllFeedback)
                            {
                                <tr class="hover:bg-slate-800/30 transition-colors">
                                    <td class="px-6 py-4 whitespace-nowrap">
                                        <div class="flex flex-col">
                                            <span class="text-sm font-semibold text-white">@feedback.User?.Username</span>
                                            <span class="text-xs text-slate-500">@feedback.User?.Email</span>
                                        </div>
                                    </td>
                                    <td class="px-6 py-4">
                                        <span class="text-sm font-medium text-slate-200">@feedback.Title</span>
                                    </td>
                                    <td class="px-6 py-4">
                                        <div class="max-w-md">
                                            <p id="desc-@feedback.Id" class="text-sm text-slate-400 line-clamp-2" title="@feedback.Description">
                                                @feedback.Description
                                            </p>
                                            @if (feedback.Description.Length > 100)
                                            {
                                                <button onclick="toggleDesc('@feedback.Id')" id="btn-@feedback.Id" class="text-xs text-sky-500 hover:text-sky-400 font-bold mt-1">Ver más</button>
                                            }
                                        </div>
                                    </td>

                                    <td class="px-6 py-4 whitespace-nowrap text-sm text-slate-500">
                                        @feedback.CreatedAt.ToLocalTime().ToString("g")
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </main>
    </div>

    <script>
        function toggleDesc(id) {
            const p = document.getElementById('desc-' + id);
            const btn = document.getElementById('btn-' + id);
            if (p.classList.contains('line-clamp-2')) {
                p.classList.remove('line-clamp-2');
                btn.innerText = 'Ver menos';
            } else {
                p.classList.add('line-clamp-2');
                btn.innerText = 'Ver más';
            }
        }
    </script>
</body>

</html>
