# Tempoo Analytics Community - self-host configuration. Copy to .env and fill it in (docs/self-hosting.md).
# Secrets are left empty on purpose: `docker compose` refuses to start while a required one is empty.
# Generate each with:  openssl rand -hex 24   (letters and digits only: they go inside connection strings).

# --- Required secrets ---
POSTGRES_PASSWORD=
CLICKHOUSE_PASSWORD=
REDIS_PASSWORD=
# Unlocks the /admin/users console.
ADMIN_MASTER_PASSWORD=

# --- First administrator (created on the first start, only if there are no users yet) ---
# Empty ADMIN_PASSWORD = a random one is generated and printed ONCE in the API log (line "FIRST RUN"): docker compose logs api
# There is no public sign-up: the administrator adds the other users from /admin/users.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# --- Optional ---
# Signing key of the sessions. Empty = generated once and kept in the api-data volume (/app/Data).
# AUTH_JWTKEY=
# Key for the management endpoints (leave empty if you do not use them).
# MANAGEMENT_APIKEY=

# Port published on the host (the gateway: app, API and event ingestion). Put your TLS reverse proxy in front of it.
GATEWAY_PORT=8000

# Address your users open (your TLS proxy in front of the gateway). Links and the logo in emails point here.
# Default: http://localhost:8000
# PUBLIC_URL=https://analytics.example.com

# Ingestion: budget of each dependency call (site config, quota, dedup) before the event gets a 503 or skips the
# check. Default 500ms. See docs/ingestion-redis-queue.md.
# INGEST_DEPENDENCY_TIMEOUT=500ms

# Database names (defaults shown).
# POSTGRES_USER=tempoo
# POSTGRES_DB=tempoo

# GeoLite2 (country and ASN by IP): downloaded on startup with your free MaxMind account. Without it everything works but
# has no country. See docs/geoip.md.
# MAXMIND_ACCOUNT_ID=
# MAXMIND_LICENSE_KEY=

# Shown in the web app: contact address (/feedback, /docs; empty = no contact line) and the header text (empty = "Tempoo Analytics").
# SUPPORT_EMAIL=
# BRAND_NAME=

# Email (password reset, welcome emails, notifications) is optional and goes through Resend. Without both variables nothing is sent
# and api.resend.com is never called; the admin console tells you when it could not email a new user's password.
# RESEND_APIKEY=
# RESEND_FROMEMAIL=

# S3-compatible bucket for Plausible/GA4 import and CSV export (docs/selfhost-s3-storage.md), used by the API and the importer
# worker. Without it those features are hidden and answer "not available on this server"; everything else works.
# STORAGE_R2_ENDPOINT=https://s3.example.com
# STORAGE_R2_ACCESS_KEY=
# STORAGE_R2_SECRET_KEY=
# STORAGE_R2_BUCKET=tempoo-exports
